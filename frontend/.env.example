# Base URL the frontend uses to reach the CivicPulse API.
# Leave as "/api" to use the Vite dev proxy (recommended for local dev).
# For a deployed build, set this to the absolute API URL, e.g.
#   VITE_API_BASE_URL=https://api.civicpulse.example.com/api
VITE_API_BASE_URL=/api

# Origin the Vite dev proxy forwards /api and /uploads to.
# Only used by vite.config.js during `npm run dev`.
VITE_BACKEND_ORIGIN=http://localhost:8000
